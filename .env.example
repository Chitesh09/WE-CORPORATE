# ==============================================================================
# WE CORPORATE — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# All secrets must remain strictly server-side.
# Never expose secrets with NEXT_PUBLIC_ prefixes.
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=https://wecorporate.in

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/we_corporate?sslmode=require

# Authentication Session Secret (Min 32 random bytes)
NEXTAUTH_SECRET=generate_with_openssl_rand_hex_32

# Cloudflare R2 / S3 Storage (Server-side only)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=we-corporate-resumes
R2_PUBLIC_DOMAIN=https://resumes.wecorporate.in

# Razorpay Payments
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_sample_public_key_id
RAZORPAY_KEY_SECRET=rzp_live_sample_private_secret_key
RAZORPAY_WEBHOOK_SECRET=your_configured_webhook_hmac_secret

# AI Provider (Server-side only)
AI_PROVIDER_API_KEY=your_secure_ai_api_key
